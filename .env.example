# GitHub OAuth token (gho_...) for copilot-api proxy.
GH_TOKEN=

# URL the pydantic-ai app uses to reach the proxy (OpenAI-compatible endpoint)
COPILOT_PROXY_URL=http://localhost:4141/v1

# Model to use via the proxy
MODEL=gpt-4o

# Copilot account type: individual | business | enterprise
ACCOUNT_TYPE=business

# Optional outbound proxy for copilot-api to reach GitHub (corp networks, etc.)
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# If your outbound proxy does TLS interception (MITM), Node must trust its CA.
# Set one of:
#   NODE_EXTRA_CA_CERTS=/absolute/path/to/proxy-ca.pem   (any Node version)
#   NODE_OPTIONS=--use-system-ca                         (Node 22+; reads macOS Keychain / Linux trust store)
NODE_EXTRA_CA_CERTS=
NODE_OPTIONS=

# Debug logging for copilot-api. VERBOSE=1 enables --verbose;
# SHOW_TOKEN=1 additionally logs GitHub/Copilot tokens on refresh.
VERBOSE=1
SHOW_TOKEN=

